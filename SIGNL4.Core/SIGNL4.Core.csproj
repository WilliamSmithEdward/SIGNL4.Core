<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SIGNL4.Core</Title>
    <Description>An unofficial client for SIGNL4's inbound webhook: sends an alert with a title, a message, a category and extra name and value pairs to a SIGNL4 team. Not made or supported by Derdack, the maker of SIGNL4.</Description>
    <Authors>WilliamSmithE</Authors>
    <Copyright>William Smith (WilliamSmithE)</Copyright>
    <PackageProjectUrl>https://github.com/WilliamSmithEdward/SIGNL4.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/SIGNL4.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>signl4;alerting;alerts;webhook;on-call;incident;notifications</PackageTags>
    <!-- The one place the version is set: the package version and the assembly version
         both come from it, and Publish refuses a tag that does not match it. -->
    <Version>2.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackageIcon>signl4_library.png</PackageIcon>
    <PackageReadmeFile>NugetReadMe.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NugetReadMe.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="signl4_library.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
